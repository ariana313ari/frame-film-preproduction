# Copy to .env and adjust. No secrets are required for the default local Ollama setup.
# Never commit a real .env file.

# Which provider adapter to use (only "ollama" ships with FRAME; see README "Adding a provider").
FRAME_LLM_PROVIDER=ollama

# Ollama server and model. qwen2.5:3b runs on CPU, but its Mongolian is limited -
# try a larger model (e.g. qwen2.5:7b) if your hardware allows it.
OLLAMA_BASE_URL=http://localhost:11434
FRAME_MODEL=qwen2.5:3b

# CPU-only generation can be slow; raise this if requests time out.
FRAME_TIMEOUT_SECONDS=300
FRAME_TEMPERATURE=0.4
FRAME_NUM_CTX=8192
