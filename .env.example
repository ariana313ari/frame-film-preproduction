# Copy to .env and adjust. Never commit a real .env file.
# On Streamlit Community Cloud there is no .env: use the app's "Secrets" instead
# (see .streamlit/secrets.toml.example).

# Which provider to use: "gemini" (Google Gemini API, the default) or "ollama" (local models).
# Ollama is only used when you set it here explicitly. There is no automatic fallback:
# if the chosen provider is misconfigured, FRAME says so.
FRAME_LLM_PROVIDER=gemini

# --- Ollama (used only when FRAME_LLM_PROVIDER=ollama) --------------------------------
# Ollama server and model. qwen2.5:3b runs on CPU, but its Mongolian is limited -
# try a larger model (e.g. qwen2.5:7b) if your hardware allows it.
OLLAMA_BASE_URL=http://localhost:11434
FRAME_MODEL=qwen2.5:3b

# CPU-only generation can be slow; raise this if requests time out.
FRAME_TIMEOUT_SECONDS=300
FRAME_TEMPERATURE=0.4
FRAME_NUM_CTX=8192

# --- Google Gemini (the default provider) ----------------------------------------------
# Create a key in Google AI Studio and put it ONLY in your local .env (which Git ignores).
# Never commit it and never paste it into the app or into chat.
GEMINI_API_KEY=
# A model with free-tier access at the time of writing (checked against Google's docs on
# 2026-10-24). Models and free-tier eligibility change - verify at
# https://ai.google.dev/gemini-api/docs/models and https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.8-flash
# Optional. Leave unset: Google recommends the default temperature for Gemini 3 models.
# GEMINI_TEMPERATURE=
# FRAME_TIMEOUT_SECONDS (above) also applies to Gemini requests.
