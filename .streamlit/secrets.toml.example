# Template for Streamlit secrets. Do NOT put real values in this file.
#
# Streamlit Community Cloud: open your app > Settings > Secrets and paste the lines below
# with your real values. Local runs: copy this file to .streamlit/secrets.toml (git-ignored).
#
# Use top-level keys (not [sections]): FRAME reads these names only.

FRAME_LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "paste-your-key-from-google-ai-studio"
# A model your key can use; verify at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL = "gemini-3.8-flash"

# Optional:
# GEMINI_TEMPERATURE = "1.0"
# FRAME_TIMEOUT_SECONDS = "120"

# Ollama is NOT used on Streamlit Cloud unless you select it AND point it at a server the
# cloud app can reach (localhost there is not your computer):
# FRAME_LLM_PROVIDER = "ollama"
# OLLAMA_BASE_URL = "https://your-reachable-ollama-host"
